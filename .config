# --- 目标与设备 ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# --- Meow 透明代理 / TUN 支持 ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_zoneinfo-asia=y

# --- Meow 官方核心与 LuCI 面板 ---
CONFIG_PACKAGE_meow=y
CONFIG_PACKAGE_luci-app-meow=y

# --- 异地组网 / DDNS ---
CONFIG_PACKAGE_luci-app-vnt2=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y

# --- 主题：Liquid ---
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
CONFIG_PACKAGE_luci-theme-liquid=y

# --- 移除 Run 安装器与旧代理组件 ---
# CONFIG_PACKAGE_luci-app-run is not set
# CONFIG_PACKAGE_honk is not set
# CONFIG_PACKAGE_luci-app-honk is not set
# CONFIG_PACKAGE_luci-lib-daeuniverse is not set
# CONFIG_PACKAGE_luci-i18n-daeuniverse-zh-cn is not set
# CONFIG_PACKAGE_dae is not set
# CONFIG_PACKAGE_daed is not set
# CONFIG_PACKAGE_daed-next is not set
# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_luci-app-daed-next is not set

# --- 取消旧代理专用内核配置与资源 ---
# CONFIG_DEVEL is not set
# CONFIG_BPF_TOOLCHAIN_HOST is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
# CONFIG_KERNEL_CGROUP_BPF is not set
# CONFIG_KERNEL_BPF_EVENTS is not set
# CONFIG_PACKAGE_kmod-sched-bpf is not set
# CONFIG_PACKAGE_kmod-veth is not set
# CONFIG_PACKAGE_kmod-nft-queue is not set
# CONFIG_PACKAGE_kmod-nfnetlink-queue is not set
# CONFIG_PACKAGE_vmlinux-btf is not set
# CONFIG_PACKAGE_vmlinux-btf-builtin is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set

