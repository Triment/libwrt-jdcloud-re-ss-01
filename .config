# --- 目标与设备 ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# --- Honk eBPF / BTF / 网络命名空间支持 ---
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_vmlinux-btf-builtin=y
# CONFIG_PACKAGE_vmlinux-btf is not set
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_zoneinfo-asia=y

# --- Honk + doona（面板版本由 CI 矩阵选择） ---
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-lib-daeuniverse=y
CONFIG_PACKAGE_luci-i18n-daeuniverse-zh-cn=y

# --- 异地组网 / DDNS ---
CONFIG_PACKAGE_luci-app-vnt2=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y

# --- 主题：Liquid ---
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
CONFIG_PACKAGE_luci-theme-liquid=y

# --- 移除 Run 安装器与旧代理组件 ---
# CONFIG_PACKAGE_luci-app-run is not set
# CONFIG_PACKAGE_dae is not set
# CONFIG_PACKAGE_daed is not set
# CONFIG_PACKAGE_daed-next is not set
# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_luci-app-daed-next is not set

